# Public canonical application URL.
# Local development example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after production SMTP, redirects and real inbox flows are verified.
AUTH_EMAIL_READY=false
# Configure a private random value of at least 32 characters in secure environment settings.
AUTH_RECOVERY_SECRET=

# Supabase public connection values.
# Use the project Connect panel values in .env.local / deployment environment variables.
# Publishable keys are safe for browser use; authorization is enforced with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Never expose service-role / secret keys through NEXT_PUBLIC_* variables.
